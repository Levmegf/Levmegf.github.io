---
import type { MarkdownHeading } from 'astro'
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import TagLink from '../components/TagLink.astro'
import CategoryLink from '../components/CategoryLink.astro'
import TableOfContents from '../components/TableOfContents.astro'
import Giscus from '../components/Giscus.astro'

interface Props {
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date
  heroImage?: string
  tags?: string[]
  category?: string
  headings?: MarkdownHeading[]
  showMeta?: boolean
  showToc?: boolean
  showComments?: boolean
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  category,
  headings = [],
  showMeta = true,
  showToc = true,
  showComments = true,
} = Astro.props
---

<html lang="zh-CN" class="dark">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>
  <body
    class="w-full max-w-screen-md mx-auto my-4 dark:bg-neutral-800 dark:text-neutral-300 transition-colors duration-300"
  >
    <Header />
    <main>
      <article class="px-4">
        {
          showMeta && (
            <div class="flex justify-between items-baseline mb-6 gap-4">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <p class="text-gray-500 dark:text-neutral-400 text-xs">
                  更新于 {updatedDate.toLocaleDateString('zh-CN')}
                </p>
              )}
            </div>
          )
        }
        <h1 class="text-4xl md:text-5xl mb-6 leading-tight">{title}</h1>

        <div class="flex flex-wrap gap-3 mb-8 text-xs">
          {category && <CategoryLink category={category} />}
          {tags?.map((tag) => <TagLink tag={tag} />)}
        </div>

        {heroImage && <img width={1020} height={510} src={heroImage} alt="" />}

        {showToc && <TableOfContents headings={headings} />}

        <div class="article-body">
          <slot />
        </div>

        {showComments && <Giscus />}
      </article>
    </main>
    <Footer />
  </body>
</html>