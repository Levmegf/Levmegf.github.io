---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import PostListItem from '../components/PostListItem.astro'
import { SITE_DESCRIPTION } from '../consts'
import { getCollection, type CollectionEntry } from 'astro:content'

type Post = CollectionEntry<'blog'>

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

// 按年份归拢，归档页就长这样
const postsByYear: Record<number, Post[]> = {}
for (const post of posts) {
  const year = post.data.pubDate.getFullYear()
  ;(postsByYear[year] ??= []).push(post)
}
const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a)
---

<!doctype html>
<html lang="zh-CN" class="min-h-dvh">
  <head>
    <BaseHead
      title="归档"
      description={SITE_DESCRIPTION}
    />
  </head>
  <body
    class="w-full max-w-screen-md mx-auto my-4 dark:bg-neutral-800 dark:text-neutral-300 transition-colors duration-300"
  >
    <Header />
    <main class="w-full max-w-screen-md mx-auto my-4 px-4 flex flex-col gap-10">
      <h1 class="text-2xl font-bold">归档</h1>
      {
        years.map((year) => (
          <section class="flex flex-col gap-4">
            <h2 class="font-bold text-xl">
              {year}
              <span class="text-sm font-normal text-gray-500 dark:text-neutral-400 ml-2">
                {postsByYear[year].length} 篇
              </span>
            </h2>
            {postsByYear[year].map((post) => <PostListItem post={post} />)}
          </section>
        ))
      }
      {
        posts.length === 0 && (
          <p class="text-gray-500 dark:text-neutral-400">还没有文章。</p>
        )
      }
    </main>
    <Footer />
  </body>
</html>