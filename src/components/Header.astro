---
import ThemeIcon from './ThemeIcon.astro'
import HeaderLink from './HeaderLink.astro'
import Icon from './Icon.astro'
import { SITE_TITLE } from '../consts'

const NAV = [{ label: '首页', href: '/' }]
---

<header
  class="lg:flex py-4 pt-2 px-4 sm:px-6 xl:px-0 md:pt-10 gap-5 mb-10 lg:mb-20 w-full"
>
  <div
    class="flex w-full justify-between items-end border-b lg:border-none pb-4 lg:pb-0"
  >
    <a class="font-semibold text-xl flex gap-2 items-center group" href="/">
      <span
        class="inline-block w-4 h-4 border-2 border-current rounded-sm transition-transform duration-300 group-hover:rotate-[17deg]"
        aria-hidden="true"></span>
      {SITE_TITLE}
    </a>
    <div class="lg:hidden flex items-center justify-center gap-4">
      <button
        id="nav-toggle"
        aria-label="切换导航菜单"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <Icon
          name="menu"
          class="nav-icon w-4 h-4 text-gray-800 dark:text-neutral-300"
        />
        <Icon
          name="close"
          class="nav-icon hidden w-4 h-4 text-gray-800 dark:text-neutral-300"
        />
      </button>
      <ThemeIcon class="w-10" />
    </div>
  </div>
  <nav id="nav-menu" class="hidden lg:flex">
    <ul
      class="flex flex-col lg:flex-row lg:gap-5 gap-3 mt-3 lg:mt-0 pb-4 lg:pb-0 border-b border-neutral-400 lg:border-b-0"
    >
      {
        NAV.map((item) => (
          <li class="flex items-center">
            <HeaderLink href={item.href}>{item.label}</HeaderLink>
          </li>
        ))
      }
      <ThemeIcon class="w-10 hidden lg:flex" />
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle')
  const menu = document.getElementById('nav-menu')

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!expanded))
    menu?.classList.toggle('hidden', expanded)
    toggle
      .querySelectorAll('.nav-icon')
      .forEach((icon) => icon.classList.toggle('hidden'))
  })
</script>