---
import { GISCUS } from '../consts'

// 两个 id 没配好就不渲染，站点照常构建
const enabled = Boolean(GISCUS.repoId && GISCUS.categoryId)
---

{
  enabled && (
    <section class="mt-16 pt-8 border-t border-gray-200 dark:border-neutral-700">
      <h2 class="font-bold text-lg mb-6">评论</h2>
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={GISCUS.repo}
        data-repo-id={GISCUS.repoId}
        data-category={GISCUS.category}
        data-category-id={GISCUS.categoryId}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="zh-CN"
        crossorigin="anonymous"
        async
      />
    </section>
  )
}