---
import Icon from './Icon.astro'
import { SITE_TITLE, SITE_DESCRIPTION, SITE_AUTHOR, SITE_START_YEAR, SITE_GITHUB } from '../consts'

const year = new Date().getFullYear()
const since = year > SITE_START_YEAR ? `${SITE_START_YEAR}–${year}` : `${year}`

const PAGES = [
  { label: '文章', href: '/blog/' },
  { label: '归档', href: '/archives/' },
  { label: '分类', href: '/categories/' },
  { label: '标签', href: '/tags/' },
  { label: '关于', href: '/about/' },
]
---

<footer class="mt-20 md:mt-36 mx-4">
  <div class="flex gap-4 border-b pb-8 mb-5 flex-col lg:flex-row">
    <div class="w-full lg:w-2/3">
      <h1 class="text-lg font-bold">{SITE_TITLE}</h1>
      <p class="text-sm">{SITE_DESCRIPTION}</p>
      <div class="flex gap-3 mt-3">
        <a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <Icon
            name="github"
            class="w-5 h-5 text-gray-600 hover:text-gray-500 dark:text-neutral-200"
          />
        </a>
      </div>
    </div>
    <div class="flex lg:ml-auto gap-10 mt-1">
      <div>
        <h1 class="font-bold mb-3 text-base">页面</h1>
        <ul class="flex flex-col gap-2 text-sm">
          {
            PAGES.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex items-center gap-1 hover:no-underline hover:text-gray-600 dark:hover:text-neutral-200"
                >
                  {item.label}
                  <Icon name="arrow-up-right" class="w-3 h-3" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
  <p class="text-sm font-medium mb-10">
    &copy; {since} {SITE_AUTHOR}. 保留所有权利。
  </p>
</footer>