---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
// 只取二三级标题，长文目录才有意义
const items = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

{
  items.length > 0 && (
    <details class="mb-10 border border-gray-200 dark:border-neutral-700 rounded-lg px-4 py-3 text-sm">
      <summary class="cursor-pointer font-medium select-none">目录</summary>
      <ul class="mt-3 flex flex-col gap-2">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-4' : ''}>
            <a
              href={`#${h.slug}`}
              class="text-gray-600 dark:text-neutral-400 hover:text-gray-900 dark:hover:text-neutral-100 hover:underline"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}